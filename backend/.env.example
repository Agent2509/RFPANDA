# ---------------------------------------------------------------------------
# RFPANDA — Backend (FastAPI) environment template
# Copy to backend/.env and fill in real values.
# ---------------------------------------------------------------------------

# --- Runtime ---
ENVIRONMENT=development      # development | production
DEBUG=false
TEST_MODE=false              # true = deterministic mock AI responses (no API keys needed)
HOST=0.0.0.0
PORT=8000

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional. Only used for legacy HS256 token verification. If your project uses
# the new asymmetric JWT signing keys, leave this blank — the backend falls back
# to Supabase's /auth/v1/user verification automatically.
SUPABASE_JWT_SECRET=

# --- CORS ---
# Comma-separated list or a JSON array. The Vercel + localhost origins are added
# automatically by the app.
CORS_ORIGINS=http://localhost:3000

# --- AI providers ---
GROQ_API_KEY=YOUR_GROQ_KEY

# Voyage AI embeddings (voyage-3 = 1024 dimensions)
VOYAGE_API_KEY=YOUR_VOYAGE_KEY
VOYAGE_MODEL=voyage-3

# --- Optional tuning ---
# VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings
# VOYAGE_MAX_RETRIES=3
# VOYAGE_TIMEOUT_SECONDS=15
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# DEFAULT_MATCH_COUNT=5
# DEFAULT_SIMILARITY_THRESHOLD=0.25
# MAX_MATCH_COUNT=20
# MEMORY_TARGET_LIMIT_MB=300
