# ---------------------------------------------------------------------------
# RFPANDA — Supabase Edge Function secrets
# These are injected into the Deno edge functions, NOT the FastAPI backend.
# Apply with:  supabase secrets set --env-file supabase/functions/.env
# ---------------------------------------------------------------------------

# LlamaParse (LlamaCloud) — primary document parser
LLAMA_CLOUD_API_KEY=YOUR_LLAMACLOUD_KEY

# Voyage AI — embeddings generated inside the ingestion edge function
VOYAGE_API_KEY=YOUR_VOYAGE_KEY
